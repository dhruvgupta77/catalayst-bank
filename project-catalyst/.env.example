# Copy to .env. Never commit real values.
DB_PASSWORD=change-me-locally
# Optional: LLM providers (only used with SPRING_PROFILES_ACTIVE=azure, gemini, openai or ollama)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Google Gemini (SPRING_PROFILES_ACTIVE=...,gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenAI (SPRING_PROFILES_ACTIVE=...,openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CATALYST_LATENCY_TARGET_MS=2000